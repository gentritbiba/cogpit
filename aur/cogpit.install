# /usr/bin/cogpit is a link made here rather than a packaged file: packages up
# to 3.6.x left one behind that no package owns, and pacman refuses to install
# over an unowned file.
post_install() {
    ln -sf /opt/Cogpit/cogpit /usr/bin/cogpit
}

post_upgrade() {
    post_install
}

post_remove() {
    if [ "$(readlink /usr/bin/cogpit 2>/dev/null)" = /opt/Cogpit/cogpit ]; then
        rm -f /usr/bin/cogpit
    fi
}
