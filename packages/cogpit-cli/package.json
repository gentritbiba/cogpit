{
  "name": "cogpit",
  "version": "2.0.0",
  "description": "Run Cogpit's local Claude Code, Codex, and GitHub Copilot CLI interface without installing it",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gentritbiba/cogpit.git",
    "directory": "packages/cogpit-cli"
  },
  "homepage": "https://github.com/gentritbiba/cogpit",
  "bugs": "https://github.com/gentritbiba/cogpit/issues",
  "keywords": [
    "claude-code",
    "codex",
    "github-copilot",
    "agent",
    "cogpit"
  ],
  "type": "module",
  "bin": {
    "cogpit": "dist/cli.js"
  },
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-npm.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.prod.json",
    "test:contracts": "bun run build && node scripts/test-package-contract.mjs",
    "prepublishOnly": "bun run test && bun run test:contracts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.215",
    "express": "^5.2.1",
    "node-pty": "^1.1.0",
    "vscode-jsonrpc": "8.2.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "esbuild": "^0.27.3",
    "typescript": "~5.6.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
