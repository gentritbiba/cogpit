{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",

    /* Path aliases */
    "paths": {
      "@/*": ["./src/*"],
      "@cogpit/core/*": ["./*"],
      "@cogpit/edition-ui": ["./editions/team/ui/index.ts", "./src/edition/absent.ts"]
    }
  },
  "include": ["src", "plugins", "editions/team/ui", "editions/team/shared", "editions/team/tests/ui"]
}
