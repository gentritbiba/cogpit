{
  "name": "cogpit",
  "private": true,
  "version": "2.7.5",
  "description": "Control center for Claude Code, OpenAI Codex, and GitHub Copilot CLI sessions",
  "license": "MIT",
  "author": {
    "name": "Gentrit Biba",
    "email": "gentritbiba@gmail.com"
  },
  "type": "module",
  "workspaces": [
    "packages/plugin-contracts",
    "packages/plugin-sdk",
    "packages/plugin-integrations",
    "packages/plugin-ui",
    "packages/plugin-tools"
  ],
  "main": "out/main/main.js",
  "scripts": {
    "dev": "bun run build:plugin-api && vite --host",
    "build": "bun run typecheck && bun run build:web",
    "build:web": "bun run build:plugin-api && vite build",
    "lint": "eslint .",
    "check:agents": "bun scripts/check-agents.ts",
    "check:architecture": "bun scripts/check-architecture.ts",
    "check:audit": "bun scripts/check-audit.ts",
    "check:cogpit-memory-sync": "bun scripts/sync-cogpit-memory.ts --check",
    "check:cogpit-skill-sync": "bun scripts/sync-cogpit-skill.ts --check",
    "check:duplicates": "bun scripts/check-duplicates.ts",
    "generate:icons": "bun scripts/generate-icons.ts",
    "test": "bun run build:plugin-api && vitest run",
    "test:watch": "bun run build:plugin-api && vitest",
    "test:coverage": "bun run build:plugin-api && vitest run --coverage",
    "typecheck": "bun run build:plugin-api && bun run typecheck:app && bun run typecheck:server && bun run typecheck:electron && bun run typecheck:memory && bun run typecheck:cli && bun run typecheck:plugin-api",
    "typecheck:app": "tsc --noEmit --pretty false -p tsconfig.app.prod.json",
    "typecheck:server": "tsc --noEmit --pretty false -p tsconfig.node.prod.json",
    "typecheck:electron": "tsc --noEmit --pretty false -p tsconfig.electron.json",
    "typecheck:memory": "tsc --noEmit --pretty false -p packages/cogpit-memory/tsconfig.prod.json",
    "typecheck:cli": "tsc --noEmit --pretty false -p packages/cogpit-cli/tsconfig.prod.json",
    "typecheck:tests": "bun run build:plugin-api && bun run typecheck:tests:app && bun run typecheck:tests:server && bun run typecheck:tests:memory && bun run typecheck:tests:cli",
    "typecheck:tests:app": "tsc --noEmit --pretty false -p tsconfig.app.json",
    "typecheck:tests:server": "tsc --noEmit --pretty false -p tsconfig.node.json",
    "typecheck:tests:memory": "tsc --noEmit --pretty false -p packages/cogpit-memory/tsconfig.json",
    "typecheck:tests:cli": "tsc --noEmit --pretty false -p packages/cogpit-cli/tsconfig.json",
    "electron:dev": "bun run build:plugin-api && electron-vite dev",
    "electron:build": "bun run build:plugin-api && electron-vite build",
    "electron:update": "bun scripts/update-local.ts",
    "electron:preview": "electron-vite build && electron .",
    "electron:package": "electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --arm64 --publish never",
    "electron:package:signed": "electron-vite build && electron-builder --publish never",
    "postinstall": "electron-builder install-app-deps && bun run build:plugin-api",
    "serve": "bun run build && bun server/standalone.ts",
    "serve:start": "bun server/standalone.ts",
    "sync-cogpit-memory": "bun scripts/sync-cogpit-memory.ts",
    "sync-cogpit-skill": "bun scripts/sync-cogpit-skill.ts",
    "ui:add": "bunx shadcn@4.16.2 add",
    "build:plugin-api": "bun run --cwd packages/plugin-contracts build && bun run --cwd packages/plugin-sdk build && bun run --cwd packages/plugin-integrations build && bun run --cwd packages/plugin-ui build && bun run --cwd packages/plugin-tools build && bun run build:runtime-plugins",
    "typecheck:plugin-api": "bun run --cwd packages/plugin-contracts typecheck && bun run --cwd packages/plugin-sdk typecheck && bun run --cwd packages/plugin-integrations typecheck && bun run --cwd packages/plugin-ui typecheck && bun run --cwd packages/plugin-tools typecheck",
    "test:contracts:plugins": "bun run build:plugin-api && bun scripts/test-plugin-package-contracts.ts",
    "build:runtime-plugins": "bun scripts/build-runtime-plugins.ts",
    "plugins:pack": "bun scripts/pack-runtime-plugin.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.270",
    "@cogpit/plugin-contracts": "workspace:*",
    "@cogpit/plugin-integrations": "workspace:*",
    "electron-updater": "^6.8.3",
    "express": "^5.2.1",
    "ipaddr.js": "2.5.0",
    "node-pty": "^1.1.0",
    "proper-lockfile": "4.1.2",
    "semver": "7.8.5",
    "smol-toml": "1.8.0",
    "tuf-js": "3.1.0",
    "vscode-jsonrpc": "8.2.1",
    "ws": "^8.21.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.112.4",
    "@base-ui/react": "^1.2.0",
    "@cogpit/plugin-sdk": "workspace:*",
    "@eslint/js": "^9.17.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@shikijs/langs": "^3.22.0",
    "@shikijs/themes": "^3.22.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tufjs/models": "3.0.1",
    "@types/css-tree": "3.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/semver": "7.7.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "css-tree": "3.2.1",
    "electron": "^41.10.4",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.14.0",
    "jscpd": "^5.0.12",
    "jsdom": "^28.1.0",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3",
    "react-resizable-panels": "^4.7.1",
    "react-zoom-pan-pinch": "^4.0.3",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.22.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "virtua": "^0.49.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "@cogpit/plugin-ui": "workspace:*"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@hono/node-server": "1.19.15",
    "@xmldom/xmldom": "0.8.15",
    "app-builder-lib": "26.15.3",
    "body-parser": "2.3.0",
    "builder-util-runtime": "9.7.0",
    "fast-uri": "4.1.4",
    "flatted": "3.4.2",
    "form-data": "4.0.6",
    "hono": "4.13.5",
    "ip-address": "10.5.0",
    "js-yaml": "4.3.2",
    "lodash": "4.18.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "qs": "6.16.0",
    "tar": "7.5.21",
    "tmp": "0.2.7",
    "undici": "7.29.0"
  },
  "patchedDependencies": {
    "electron-vite@5.0.0": "patches/electron-vite@5.0.0.patch"
  }
}
