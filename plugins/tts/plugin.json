{
  "manifestVersion": 1,
  "id": "cogpit.tts",
  "publisher": "cogpit",
  "name": "Text to speech",
  "version": "1.1.0",
  "runtime": "browser-iife-v1",
  "entry": "plugin.js",
  "style": "plugin.css",
  "engines": { "pluginApi": "^1.3.0", "client": ">=3.3.6", "host": ">=3.3.6" },
  "requires": { "client": { "chat.blocks": "^1.0.0", "session.actions": "^1.0.0", "media.audio": "^1.0.0", "settings.fields": "^1.0.0" }, "host": { "connections.media": "^1.0.0", "connections.upload": "^1.0.0", "settings.fields": "^1.0.0", "skills.context": "^1.0.0" } },
  "optional": { "client": { "composer.dictation": "^1.0.0" }, "host": {} },
  "browser": ["message-channel", "blob-script", "web-crypto"],
  "contributes": {
    "panels": [],
    "chatBlocks": [{ "id": "speech", "title": "Text to speech", "height": 260 }],
    "skills": [{ "id": "speech", "title": "Text to speech", "description": "Offer text that the user can generate and listen to as speech in a Cogpit chat card.", "source": "skills/speech/SKILL.md" }],
    "sessionActions": [{ "id": "summary", "title": "Spoken summary", "icon": "speaker", "skill": "speech", "prompt": "Use the cogpit.tts speech skill to summarize what matters from this conversation. Keep it as short and simple as possible, using words someone would actually say in a meeting or call. Use prose only, with no lists, bullets, numbered points, or headings. Include the important result and anything unresolved or needed next only when it matters. Put the summary inside a Markdown fence with language cogpit:cogpit.tts:speech." }],
    "dictation": { "title": "Dictate", "connection": "speech", "operation": "transcribe", "text": "/text" },
    "settings": { "scope": "plugin", "fields": [
      { "id": "speed", "label": "Speech speed", "description": "1 is normal speed.", "type": "number", "default": 1, "min": 0.5, "max": 2, "step": 0.1 },
      { "id": "format", "label": "Audio format", "type": "select", "default": "mp3", "options": [{ "value": "mp3", "label": "MP3" }, { "value": "wav", "label": "WAV" }] }
    ] }
  },
  "permissions": {
    "connections": [{ "id": "speech", "definition": "connections/speech.json", "operations": ["synthesize", "transcribe"] }]
  },
  "stateVersion": 1
}
